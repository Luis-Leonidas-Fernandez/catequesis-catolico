<%
  const escapeHtml = (value) => String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
  const safeLoginPosterUrl = loginPosterUrl ? escapeHtml(loginPosterUrl) : '';
  const safeLoginVideoUrl = loginVideoUrl ? escapeHtml(loginVideoUrl) : '';
  const backgroundMarkup = `${safeLoginPosterUrl ? `<img class="login-bg-image" src="${safeLoginPosterUrl}" alt="" aria-hidden="true" loading="eager" decoding="async" />` : ''}${safeLoginVideoUrl ? `<video class="login-bg-video" autoplay muted loop playsinline preload="metadata" ${safeLoginPosterUrl ? `poster="${safeLoginPosterUrl}"` : ''} aria-hidden="true" tabindex="-1"><source src="${safeLoginVideoUrl}" type="video/mp4"></video>` : ''}`;
%>

<%- include('layout', {
  title,
  body: `
    <main class="login-shell${safeLoginPosterUrl ? ' login-shell--has-poster' : ''}">
      ${backgroundMarkup}
      <div class="login-overlay" aria-hidden="true"></div>
      <section class="login-content" aria-label="Restablecer contraseña">
        <div class="login-card">
          <div class="login-header">
            <span class="badge text-bg-primary mb-3">Catequesis San Pedro</span>
            <h1 class="login-title">Elegí una nueva contraseña</h1>
            <p class="login-subtitle">Usá al menos 8 caracteres. El enlace puede utilizarse una sola vez.</p>
          </div>

          ${error ? `<div class="alert alert-danger" role="alert">${escapeHtml(error)}</div>` : ''}
          ${passwordError ? `<div class="alert alert-danger" role="alert">${escapeHtml(passwordError)}</div>` : ''}

          ${token ? `
            <form class="login-form" action="/restablecer-contrasena" method="post" novalidate>
              <input type="hidden" name="_csrf" value="${escapeHtml(csrfToken)}" />
              <input type="hidden" name="token" value="${escapeHtml(token)}" />
              <div class="login-field">
                <label class="form-label" for="password">Nueva contraseña</label>
                <input class="form-control" id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
                <div class="form-text">Debe tener al menos 8 caracteres.</div>
              </div>
              <button class="btn btn-primary login-submit" type="submit">Actualizar contraseña</button>
            </form>
          ` : ''}

          <p class="login-secondary-action"><a href="/recuperar-cuenta">Solicitar otro enlace</a></p>
          <p class="login-secondary-action mt-1"><a href="/login">Volver a iniciar sesión</a></p>
        </div>
      </section>
    </main>
  `
}) %>
