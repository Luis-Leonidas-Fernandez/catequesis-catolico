<%
  const escapeHtml = (value) => String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
  const safeLoginPosterUrl = loginPosterUrl ? escapeHtml(loginPosterUrl) : '';
  const safeLoginVideoUrl = loginVideoUrl ? escapeHtml(loginVideoUrl) : '';
  const backgroundMarkup = `${safeLoginPosterUrl ? `<img class="login-bg-image" src="${safeLoginPosterUrl}" alt="" aria-hidden="true" loading="eager" decoding="async" />` : ''}${safeLoginVideoUrl ? `<video class="login-bg-video" autoplay muted loop playsinline preload="metadata" ${safeLoginPosterUrl ? `poster="${safeLoginPosterUrl}"` : ''} aria-hidden="true" tabindex="-1"><source src="${safeLoginVideoUrl}" type="video/mp4"></video>` : ''}`;
%>

<%- include('layout', {
  title,
  body: `
    <main class="login-shell${safeLoginPosterUrl ? ' login-shell--has-poster' : ''}">
      ${backgroundMarkup}
      <div class="login-overlay" aria-hidden="true"></div>
      <section class="login-content" aria-label="Recuperar contraseña">
        <div class="login-card">
          <div class="login-header">
            <span class="badge text-bg-primary mb-3">Catequesis San Pedro</span>
            <h1 class="login-title">Recuperá tu contraseña</h1>
            <p class="login-subtitle">Ingresá el email de tu cuenta adulta y te enviaremos un enlace seguro.</p>
          </div>

          ${error ? `<div class="alert alert-danger" role="alert">${escapeHtml(error)}</div>` : ''}
          ${message ? `<div class="alert alert-success" role="status">${escapeHtml(message)}</div>` : ''}

          <form class="login-form" action="/recuperar-cuenta" method="post" novalidate>
            <input type="hidden" name="_csrf" value="${escapeHtml(csrfToken)}" />
            <div class="login-field">
              <label class="form-label" for="email">Email</label>
              <input class="form-control" id="email" name="email" type="email" value="${escapeHtml(email)}" autocomplete="email" required />
            </div>
            <button class="btn btn-primary login-submit" type="submit">Enviar instrucciones</button>
          </form>

          <p class="login-secondary-action"><a href="/login">Volver a iniciar sesión</a></p>
        </div>
      </section>
    </main>
  `
}) %>
